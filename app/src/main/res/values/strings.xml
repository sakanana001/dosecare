    <!-- PK 参数 -->
    <string name="plain_half_life_short">短效 (体内代谢快, 通常一天 3-4 次服药)</string>
    <string name="plain_half_life_medium">中效 (一天 1-2 次服药即可)</string>
    <string name="plain_half_life_long">长效 (一天 1 次服药, 偶尔漏服问题不大)</string>
    <string name="plain_half_life_xlong">超长效 (体内停留很久, 停药后 1-4 周还有残余效应)</string>
