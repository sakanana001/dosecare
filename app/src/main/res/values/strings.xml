    <!-- ====== 血药浓度推测 TDM ====== -->
    <string name="tdm_title">血药浓度推测 (TDM)</string>
    <string name="tdm_data_source_info">数据源与校准说明</string>
    <string name="tdm_no_drugs">暂无可 TDM 监测的药物(需要 therapeuticWindow 字段)</string>
    <string name="tdm_data_source_title">📚 数据源 &amp; 校准说明</string>
    <string name="tdm_data_source_lines">• PK 参数: AGNP 2017 (Therapeutic Drug Monitoring in Psychiatry) + FDA DailyMed 药品标签\n• CYP 谱: Flockhart Table (Indiana University)\n• 治疗窗: AGNP 2017 共识指南\n• 体重调整: Vd = vdLPerKg × weight(假设线性)</string>
    <string name="tdm_limitations">⚠️ 局限性</string>
    <string name="tdm_limitations_lines">• 1 房室口服模型 — 对非线性药(苯妥英)不准确,对肾清除药(锂)仅近似\n• 群体平均参数 — 个体差异 2-3 倍(CYP 基因型 / 吸烟 / 年龄 / 肾 / 肝)\n• 多药曲线仅显示浓度叠加,不模拟 CYP 竞争/酶抑制动力学\n• v0.4 不替代医师判断;实际用药请遵医嘱或咨询临床药师</string>
    <string name="tdm_predict_n_drugs">推测 %1$d 药血药浓度</string>
    <string name="tdm_add_drug_to_chart">添加药到图表</string>
    <string name="tdm_add_drug_n">%1$d 个药可选 (有/无 TDM 均可)</string>
    <string name="tdm_add">添加</string>
    <string name="tdm_dose_mg">剂量 (mg)</string>
    <string name="tdm_weight_kg">体重 (kg)</string>
    <string name="tdm_freq">频次:</string>
    <string name="tdm_chart_title">多药稳态浓度-时间曲线 (可点击/拖动/缩放)</string>

    <!-- ====== 双药对比 ====== -->
    <string name="compare_title">双药对比</string>
    <string name="compare_card_title">双药规格对比</string>
    <string name="compare_info">对比说明</string>
    <string name="compare_info_title">ℹ️ 双药对比说明</string>
    <string name="compare_info_lines">• 选两个药,按 7 个 section 对比 (基本信息 / 药代动力学 / 治疗窗 / CYP 角色 / 不良反应 / 剂量调整 / 监测)\n• 同值自动合并,不同值分两列展示\n• 治疗窗 / CYP 谱参考 AGNP 2017 + Flockhart Table\n• 不良反应等级: VERY_LOW / LOW / MEDIUM / HIGH / VERY_HIGH\n• 本工具仅展示规格差异,临床决策请结合实际病人情况</string>
    <string name="compare_drug_a">药 A</string>
    <string name="compare_drug_b">药 B</string>
    <string name="compare_lay_title">📖 通俗模式</string>
    <string name="compare_lay_disclaimer">⚠️ 各项参数请以实际药品说明书/化验值为准。\n用药调整、相互作用警示请遵医嘱或咨询临床药师。</string>
    <string name="compare_diff_title">📖 关键差异 (通俗版)</string>
    <string name="compare_diff_empty">两药在主要指标上没有明显差异。具体使用仍请遵医嘱。</string>
    <string name="compare_critical_inbound">互相影响 (对方在 criticalInteractions 中引用了我)</string>
    <string name="compare_hint_legend">💡 A → B 表示 A 药会让 B 药浓度变化; 数字越大变化越剧烈 (1.5 倍=轻, 5 倍以上=严重)</string>
    <string name="compare_mechanism_auc">%1$s · AUC 变化 %2$s - %3$s 倍</string>

    <!-- ====== 相互作用 ====== -->
    <string name="interaction_title">相互作用 · %1$d 药</string>
    <string name="interaction_card_title">多药相互作用</string>
    <string name="interaction_info">评估说明</string>
    <string name="interaction_info_title">ℹ️ 多药相互作用说明</string>
    <string name="interaction_info_lines">• 添加 2+ 个药,RuleEngine 跑所有组合 (N×(N-1)/2 对)\n• 6 类规则: CYP 抑制/诱导、QTc 累积、抗胆碱能、5-HT 综合征、治疗窗偏离、肾/肝剂量调整\n• 严重度: LOW / MEDIUM / HIGH / CONTRAINDICATED\n• 个体差异极大,用药请遵医嘱或咨询临床药师</string>
    <string name="interaction_selected_n">已选 (%1$d):</string>
    <string name="interaction_add_drug_n">添加药 · 搜索 (%1$d 可选)</string>
    <string name="interaction_search_hint">🔍 搜索: 氟 / fluvoxamine / 氯氮平 / F</string>
    <string name="interaction_evaluate_n">评估 %1$d 药的所有组合</string>
    <string name="interaction_reevaluate_n">重新评估 %1$d 药的所有组合</string>
    <string name="interaction_no_alerts_title">✓ RuleEngine 未检出 6 类已知警示。</string>
    <string name="interaction_no_alerts_desc">但这不代表安全——本次评估仅覆盖:CYP 抑制/诱导、QTc 累积、抗胆碱能负荷、5-HT 综合征、治疗窗偏离、肾/肝剂量调整。实际临床还要考虑:年龄、肝肾、基因型(CYP2D6/2C19 慢代谢)、蛋白结合置换、肠肝循环、食物/草本补充剂等。个体差异极大,仍请遵医嘱。</string>
    <string name="interaction_alerts_count">RuleEngine 检出 %1$d 条警示</string>
    <string name="interaction_high_overdose_n">⚠️ %1$d 药为高风险过量 (重症 / 危及生命)</string>
    <string name="interaction_overdose_help">过量处理需多药协调(活性炭 / 血液透析 / 解毒剂等), 立即拨打 120 或当地中毒急救中心</string>
