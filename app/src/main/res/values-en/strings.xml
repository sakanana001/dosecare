    <!-- ====== TDM  ====== -->
    <string name="tdm_title">Plasma Level Estimation (TDM)</string>
    <string name="tdm_data_source_info">Data source &amp; calibration info</string>
    <string name="tdm_no_drugs">No TDM-monitorable drugs (requires therapeuticWindow field)</string>
    <string name="tdm_data_source_title">📚 Data Sources &amp; Calibration</string>
    <string name="tdm_data_source_lines">• PK parameters: AGNP 2017 (Therapeutic Drug Monitoring in Psychiatry) + FDA DailyMed drug labels\n• CYP spectrum: Flockhart Table (Indiana University)\n• Therapeutic window: AGNP 2017 consensus\n• Weight adjustment: Vd = vdLPerKg × weight (assumes linear)</string>
    <string name="tdm_limitations">⚠️ Limitations</string>
    <string name="tdm_limitations_lines">• 1-compartment oral model — inaccurate for non-linear drugs (phenytoin), only approximate for renal-cleared drugs (lithium)\n• Population-averaged parameters — individual variation 2-3× (CYP genotype / smoking / age / renal / hepatic)\n• Multi-drug curves only show concentration overlap; do not model CYP competition / enzyme inhibition dynamics\n• v0.4 does not replace clinical judgment; consult your physician or clinical pharmacist</string>
    <string name="tdm_predict_n_drugs">Estimate %1$d drug plasma levels</string>
    <string name="tdm_add_drug_to_chart">Add drug to chart</string>
    <string name="tdm_add_drug_n">%1$d drugs available (with/without TDM both ok)</string>
    <string name="tdm_add">Add</string>
    <string name="tdm_dose_mg">Dose (mg)</string>
    <string name="tdm_weight_kg">Weight (kg)</string>
    <string name="tdm_freq">Frequency:</string>
    <string name="tdm_chart_title">Multi-drug steady-state concentration-time curve (tap/drag/pinch to interact)</string>

    <!-- ====== Compare ====== -->
    <string name="compare_title">Drug Comparison</string>
    <string name="compare_card_title">Two-drug spec comparison</string>
    <string name="compare_info">Compare info</string>
    <string name="compare_info_title">ℹ️ Two-drug Comparison Info</string>
    <string name="compare_info_lines">• Pick two drugs, compare across 7 sections (basics / PK / therapeutic window / CYP role / side effects / dose adjustment / monitoring)\n• Same values are merged automatically, different values shown in two columns\n• Therapeutic window / CYP spectrum references AGNP 2017 + Flockhart Table\n• Side effect severity: VERY_LOW / LOW / MEDIUM / HIGH / VERY_HIGH\n• This tool only shows spec differences; clinical decisions should consider the actual patient context</string>
    <string name="compare_drug_a">Drug A</string>
    <string name="compare_drug_b">Drug B</string>
    <string name="compare_lay_title">📖 Layman Mode</string>
    <string name="compare_lay_disclaimer">⚠️ All parameters should be verified against the actual drug label / lab values.\nConsult your physician or clinical pharmacist for medication adjustments and interaction alerts.</string>
    <string name="compare_diff_title">📖 Key Differences (Layman)</string>
    <string name="compare_diff_empty">The two drugs show no obvious differences in main indicators. Follow your physician for actual use.</string>
    <string name="compare_critical_inbound">Mutual influence (the other references me in criticalInteractions)</string>
    <string name="compare_hint_legend">💡 A → B means drug A will change drug B\'s concentration; larger numbers mean more dramatic change (1.5× = mild, 5×+ = severe)</string>
    <string name="compare_mechanism_auc">%1$s · AUC change %2$s - %3$s ×</string>

    <!-- ====== Interactions ====== -->
    <string name="interaction_title">Interactions · %1$d drugs</string>
    <string name="interaction_card_title">Multi-drug interactions</string>
    <string name="interaction_info">Evaluation info</string>
    <string name="interaction_info_title">ℹ️ Multi-drug Interaction Info</string>
    <string name="interaction_info_lines">• Add 2+ drugs, RuleEngine runs all combinations (N×(N-1)/2 pairs)\n• 6 rule categories: CYP inhibition/induction, QTc accumulation, anticholinergic, 5-HT syndrome, therapeutic window deviation, renal/hepatic dose adjustment\n• Severity: LOW / MEDIUM / HIGH / CONTRAINDICATED\n• Individual variation is significant; consult your physician or clinical pharmacist</string>
    <string name="interaction_selected_n">Selected (%1$d):</string>
    <string name="interaction_add_drug_n">Add drug · search (%1$d available)</string>
    <string name="interaction_search_hint">🔍 Search: flu / fluvoxamine / clozapine / F</string>
    <string name="interaction_evaluate_n">Evaluate all %1$d drug combinations</string>
    <string name="interaction_reevaluate_n">Re-evaluate all %1$d drug combinations</string>
    <string name="interaction_no_alerts_title">✓ RuleEngine found none of the 6 known alert categories.</string>
    <string name="interaction_no_alerts_desc">But this does not mean safe — this evaluation only covers: CYP inhibition/induction, QTc accumulation, anticholinergic load, 5-HT syndrome, therapeutic window deviation, renal/hepatic dose adjustment. Actual clinical practice also considers: age, liver/kidney, genotype (CYP2D6/2C19 poor metabolizers), protein binding displacement, enterohepatic circulation, food/herbal supplements. Individual variation is significant; still consult your physician.</string>
    <string name="interaction_alerts_count">RuleEngine found %1$d alerts</string>
    <string name="interaction_high_overdose_n">⚠️ %1$d drugs with high overdose risk (severe / life-threatening)</string>
    <string name="interaction_overdose_help">Overdose treatment requires multi-drug coordination (activated charcoal / hemodialysis / antidote, etc.). Call 120 or local poison control immediately.</string>
    <string name="interaction_advice">Suggestion: %1$s</string>
    <string name="interaction_references">References: %1$s</string>
    <string name="interaction_n_drugs_available">%1$d drugs available</string>
