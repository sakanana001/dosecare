    <!-- ====== Plain layman mode (DrugDetailScreen / ComparisonView toggle) ====== -->
    <!-- PK parameters -->
    <string name="plain_half_life_short">Short-acting (metabolized quickly; usually 3-4 doses per day)</string>
    <string name="plain_half_life_medium">Medium-acting (1-2 doses per day is enough)</string>
    <string name="plain_half_life_long">Long-acting (once-daily dosing; occasional missed doses are fine)</string>
    <string name="plain_half_life_xlong">Very long-acting (stays in body a long time; residual effects last 1-4 weeks after stopping)</string>
    <string name="plain_protein_high">Highly bound to blood proteins (only %1$d%% free to enter cells; hard to dialyze)</string>
    <string name="plain_protein_mid">Moderately bound (%1$d%% free fraction)</string>
    <string name="plain_protein_low">Low binding (most %1$d%% free; easily distributed throughout the body)</string>
    <string name="plain_therapeutic_window">Blood levels below %1$s %2$s may be ineffective; above %3$s %2$s risk toxicity; lab draws should fall in this range</string>
    <string name="plain_cmax">Peak blood level after dose: %1$s %2$s (highest right after taking)</string>
    <string name="plain_cmin">Trough level before next dose: %1$s %2$s (weakest effect)</string>
    <string name="plain_cavg">Steady-state average level: %1$s %2$s (long-term average in blood)</string>
    <string name="plain_auc">AUC: total drug exposure in the body; higher value means more drug contact</string>

    <!-- CYP roles -->
    <string name="plain_cyp_substrate">This drug is broken down by liver enzymes. Higher dose or enzyme inhibition raises blood levels → overdose risk</string>
    <string name="plain_metabolism_cyp">Mainly metabolized by liver CYP enzymes; prone to interactions with CYP inhibitors/inducers</string>
    <string name="plain_metabolism_ugt">Metabolized by glucuronidation (Phase II); usually no CYP-mediated interactions; few interactions</string>
    <string name="plain_metabolism_renal">Excreted unchanged by the kidneys; no hepatic metabolism; almost no CYP-mediated interactions; reduce dose in renal failure</string>
    <string name="plain_metabolism_hydrolysis">Hydrolyzed by plasma/tissue esterases; does not depend on liver/kidney function; few drug interactions</string>
    <string name="plain_metabolism_deiodination">Metabolized by deiodinase (thyroid hormone-specific pathway); few interactions</string>
    <string name="plain_metabolism_mao">Metabolized by monoamine oxidase; watch for tyramine reaction (cheese effect)</string>
    <string name="plain_metabolism_dpp4">Degraded by DPP-IV enzyme (GLP-1 analogs); injectable administration</string>
    <string name="plain_metabolism_beta_oxidation">Via fatty acid β-oxidation + UGT glucuronidation; multi-pathway metabolism</string>
    <string name="plain_metabolism_other">Other metabolic pathways; see catalog for details</string>
    <string name="plain_cyp_inhibitor_strong">Strong inhibitor: makes other drugs stay longer in body; levels may rise 5× (must reduce co-administered dose)</string>
    <string name="plain_cyp_inhibitor_moderate">Moderate inhibitor: raises other drug levels 2-5× (monitor when co-administered)</string>
    <string name="plain_cyp_inhibitor_weak">Weak inhibitor: minimal effect; usually no adjustment needed</string>
    <string name="plain_cyp_inducer_strong">Strong inducer: shortens other drug residence; levels may drop 50%% or more (often need higher dose or alternative; oral contraceptives may fail)</string>
    <string name="plain_cyp_inducer_moderate">Moderate inducer: lowers other drug levels 30-50%%</string>
    <string name="plain_cyp_inducer_weak">Weak inducer: minor effect</string>

    <!-- Adjustments (renal/hepatic/elderly) -->
    <string name="plain_renal_none">No adjustment if kidney function is normal</string>
    <string name="plain_renal_monitor">If kidney function declines, closely monitor renal function and drug levels</string>
    <string name="plain_renal_reduce_egfr30">When eGFR &lt; 30, halve the dose (contraindicated in severe renal failure)</string>
    <string name="plain_renal_contra_egfr30">Contraindicated when eGFR &lt; 30 (may further damage kidney function)</string>
    <string name="plain_hepatic_none">No adjustment if liver function is normal</string>
    <string name="plain_hepatic_monitor">Monitor liver function if abnormal</string>
    <string name="plain_hepatic_reduce_pugh_b">Moderate liver impairment (Child-Pugh B): halve the dose</string>
    <string name="plain_hepatic_reduce_pugh_c">Severe liver impairment (Child-Pugh C): halve or discontinue</string>
    <string name="plain_hepatic_contra_severe">Contraindicated in severe liver disease (accumulation → toxicity)</string>
    <string name="plain_elderly">Elderly have slower metabolism and declining liver/kidney function; start low, titrate slowly, watch for falls and cognitive changes</string>

    <!-- Side effects -->
    <string name="plain_qtc_low">Minimal QT prolongation; good cardiac safety profile</string>
    <string name="plain_qtc_medium">Moderate QT prolongation; arrhythmia risk rises with other QT-prolonging drugs or low K+/Mg2+</string>
    <string name="plain_qtc_high">Marked QT prolongation; risk of torsades de pointes (fatal arrhythmia); contraindicated with other QT drugs</string>
    <string name="plain_metabolic_low">No effect on blood glucose/lipids/weight</string>
    <string name="plain_metabolic_medium">May raise blood glucose and weight gain (+2.5-5 kg over months is common)</string>
    <string name="plain_metabolic_high">Significant metabolic disturbance: weight gain, dyslipidemia, diabetes risk; monitor weight/glucose/lipids during treatment</string>
    <string name="plain_agran_low">Agranulocytosis risk very low (no special monitoring required)</string>
    <string name="plain_agran_medium">May cause white blood cell drop; periodic CBC required</string>
    <string name="plain_agran_high">Significant agranulocytosis risk (fatal infection); CBC every 1-4 weeks mandatory; seek care immediately if fever</string>
    <string name="plain_eps_low">Minimal extrapyramidal symptoms (dystonia/tremor/akathisia)</string>
    <string name="plain_eps_medium">May cause rigidity, tremor, akathisia, acute dystonia</string>
    <string name="plain_eps_high">Marked EPS risk: parkinsonism/akathisia/tardive dyskinesia (irreversible); additive with multiple antipsychotics</string>
    <string name="plain_sedation_low">Minimal sedation; safe to drive</string>
