    <!-- ====== Settings ====== -->
    <string name="settings_title">Settings · About</string>
    <string name="settings_language">🌐 Language</string>
    <string name="settings_data_source">📚 Data Sources</string>
    <string name="settings_data_source_lines">• DrugCatalog: AGNP 2017 + FDA DailyMed + Flockhart CYP Table\n• PK parameters: 1-compartment oral model\n• Therapeutic window: AGNP 2017 TDM consensus\n• Interactions: RuleEngine 6-category custom rules</string>
    <string name="settings_limitations">⚠️ Limitations</string>
    <string name="settings_limitations_lines">• 1-compartment model is inaccurate for some drugs (e.g. phenytoin non-linear metabolism, lithium renal clearance)\n• Population-averaged parameters; individual variation 2-3× (CYP genotype / smoking / age / renal / hepatic)\n• v0.3.2 does not call external medical database APIs; PK data is based on AGNP/FDA static sources\n• Does not replace clinical judgment; consult your physician or clinical pharmacist</string>
    <string name="settings_roadmap">🗺 Roadmap</string>
    <string name="settings_roadmap_v04">v0.4 plan: Hilt DI + Room persistence + medication reminders</string>
    <string name="settings_roadmap_v05">v0.5 plan: Multi-compartment PK + patient profile (smoking/renal/hepatic) calibration</string>
    <string name="settings_roadmap_v10">v1.0 plan: Online medical DB calibration + Population PK Bayes estimation</string>
    <string name="settings_roadmap_v15">v1.5 plan: KMP multi-platform</string>
    <string name="settings_disclaimer">⚠️ All calculations (PK estimation, alerts) are for reference only. Individual variation is significant; consult your physician for actual medication decisions.</string>

