<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- DoseCare 不使用 Auto Backup：药物数据用 SQLCipher 加密，需要用户显式导出 -->
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
