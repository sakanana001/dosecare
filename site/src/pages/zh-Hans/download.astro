---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDictionary, type Locale } from '../../i18n/ui';

const locale: Locale = 'zh-Hans';
const t = getDictionary(locale);
---

<BaseLayout title={t.download.title} description={t.download.intro}>
  <header class="hero">
    <div class="hero-content">
      <div class="icon-tile">
        <svg width="56" height="56" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M5 20h14v-2H5m14-9h-4V3H9v6H5l7 7l7-7Z" />
        </svg>
      </div>
      <div>
        <h1 class="h1">{t.download.title}</h1>
        <p class="subtitle">{t.download.intro}</p>
        <div class="hero-cta">
          <a class="cta-button" href="https://github.com/sakanana001/dosecare/releases" target="_blank" rel="noopener">
            <svg width="20" height="20" aria-hidden="true" viewBox="0 0 24 24">
              <path fill="currentColor" d="M16 1H4v22h2V3h10V1zm4 4H8v22h2V17h10V5zm-2 10H10V7h8v8z" />
            </svg>
            <span>{t.download.latestCta}</span>
          </a>
        </div>
      </div>
    </div>
  </header>

  <main class="card-inset">
    <section class="prose-block">
      <h2 class="h2">{t.download.latestTitle}</h2>
      <p>{t.download.latestNote}</p>
    </section>

    <section class="prose-block">
      <h2 class="h2">{t.download.howTitle}</h2>
      <p>{t.download.howIntro}</p>
      <ol class="steps">
        {t.download.howSteps.map((step) => <li>{step}</li>)}
      </ol>
    </section>

    <section class="prose-block">
      <h2 class="h2">{t.download.flavorsTitle}</h2>
      <p>{t.download.flavorsIntro}</p>
      <table class="flavor-table">
        <thead>
          <tr><th>Flavor</th><th>目标 ABI</th><th>何时用</th></tr>
        </thead>
        <tbody>
          {t.download.flavors.map((f) => (
            <tr>
              <td><code>{f.name}</code></td>
              <td><code>{f.target}</code></td>
              <td>{f.use}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="prose-block">
      <h2 class="h2">{t.download.buildTitle}</h2>
      <p>{t.download.buildIntro}</p>
    </section>

    <section class="prose-block">
      <h2 class="h2">{t.download.verifyingTitle}</h2>
      <p>{t.download.verifyingIntro}</p>
      <pre><code>gpg --verify dosecare-all-abis-1.3.3-&lt;hash&gt;-&lt;n&gt;.apk.asc dosecare-all-abis-1.3.3-&lt;hash&gt;-&lt;n&gt;.apk
sha256sum -c dosecare-all-abis-1.3.3-&lt;hash&gt;-&lt;n&gt;.apk.sha256</code></pre>
    </section>

    <p class="disclaimer">{t.download.disclaimer}</p>

    <p class="page-end-link">
      <a href="/DoseCare/zh-Hans/">
        <span>← {t.nav.home}</span>
      </a>
    </p>
  </main>
</BaseLayout>
