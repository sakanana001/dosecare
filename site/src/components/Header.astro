---
import { getDictionary, sisterPath, type Locale } from '../i18n/ui';
import { siteUrl } from '../config';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);
const currentPath = Astro.url.pathname;

const navItems = [
  { href: siteUrl('/'), label: t.nav.home, key: 'home' },
  { href: siteUrl('/download/'), label: t.nav.download, key: 'download' },
  { href: siteUrl('/privacy/'), label: t.nav.privacy, key: 'privacy' },
];

function isCurrent(href: string): boolean {
  if (href === siteUrl('/') || href === siteUrl('')) {
    return currentPath === siteUrl('/') || currentPath === siteUrl('') || currentPath === '/DoseCare/' || currentPath === '/DoseCare';
  }
  return currentPath.startsWith(href);
}
---

<header class="topbar">
  <div class="topbar-inner">
    <nav class="site-nav" aria-label="Site">
      <a href={siteUrl('/')} class="site-nav__brand">
        <span class="site-nav__brand-mark">P</span>
        <span>DoseCare</span>
        <span class="site-nav__current">— {t.site.forkNote}</span>
      </a>
      <ul class="site-nav__links">
        {navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="site-nav__actions">
        <div class="theme-selector" role="group" aria-label={t.theme.selector}>
          <button
            type="button"
            class="theme-selector__option"
            aria-label={t.theme.auto}
            aria-pressed="true"
            data-theme-option="auto"
          >
            <svg width="1em" height="1em" aria-hidden="true" viewBox="0 0 24 24">
              <path fill="currentColor" d="M12 18V6a6 6 0 0 1 6 6a6 6 0 0 1-6 6m0 0a6 6 0 0 1-6-6a6 6 0 0 1 6-6m0-9a9 9 0 0 0-9 9a9 9 0 0 0 9 9a9 9 0 0 0 9-9a9 9 0 0 0-9-9Z" />
            </svg>
          </button>
          <button
            type="button"
            class="theme-selector__option"
            aria-label={t.theme.day}
            aria-pressed="false"
            data-theme-option="light"
          >
            <svg width="1em" height="1em" aria-hidden="true" viewBox="0 0 24 24">
              <path fill="currentColor" d="M12 7a5 5 0 0 0-5 5a5 5 0 0 0 5 5a5 5 0 0 0 5-5a5 5 0 0 0-5-5m0 8a3 3 0 0 1-3-3a3 3 0 0 1 3-3a3 3 0 0 1 3 3a3 3 0 0 1-3 3m0-13a1 1 0 0 1 1 1v2a1 1 0 0 1-2 0V3a1 1 0 0 1 1-1m0 17a1 1 0 0 1 1 1v2a1 1 0 0 1-2 0v-2a1 1 0 0 1 1-1M4.22 4.22a1 1 0 0 1 1.41 0l1.42 1.42a1 1 0 0 1-1.41 1.41L4.22 5.64a1 1 0 0 1 0-1.42m12.73 12.73a1 1 0 0 1 1.41 0l1.42 1.42a1 1 0 0 1-1.41 1.41l-1.42-1.42a1 1 0 0 1 0-1.41M2 12a1 1 0 0 1 1-1h2a1 1 0 0 1 0 2H3a1 1 0 0 1-1-1m17 0a1 1 0 0 1 1-1h2a1 1 0 0 1 0 2h-2a1 1 0 0 1-1-1M4.22 19.78a1 1 0 0 1 0-1.41l1.42-1.42a1 1 0 0 1 1.41 1.41l-1.42 1.42a1 1 0 0 1-1.41 0m12.73-12.73a1 1 0 0 1 0-1.41l1.42-1.42a1 1 0 0 1 1.41 1.41l-1.42 1.42a1 1 0 0 1-1.41 0" />
            </svg>
          </button>
          <button
            type="button"
            class="theme-selector__option"
            aria-label={t.theme.night}
            aria-pressed="false"
            data-theme-option="dark"
          >
            <svg width="1em" height="1em" aria-hidden="true" viewBox="0 0 24 24">
              <path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26a5.4 5.4 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1Z" />
            </svg>
          </button>
        </div>
        <div class="language-picker" data-language-picker>
          <button
            type="button"
            id="language-select-button"
            class="language-select-button"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-label={t.language.selector}
          >
            <svg width="1em" height="1em" aria-hidden="true" viewBox="0 0 24 24">
              <path fill="currentColor" d="M17.9 17.39c-.26-.8-1.01-1.39-1.9-1.39h-1v-3a1 1 0 0 0-1-1H8v-2h2a1 1 0 0 0 1-1V7h2a2 2 0 0 0 2-2v-.41a7.984 7.984 0 0 1 2.9 12.8M11 19.93c-3.95-.49-7-3.85-7-7.93c0-.62.08-1.22.21-1.79L9 15v1a2 2 0 0 0 2 2m1-16A10 10 0 0 0 2 12a10 10 0 0 0 10 10a10 10 0 0 0 10-10A10 10 0 0 0 12 2" />
            </svg>
            <span id="language-select-value">{locale === 'zh-Hans' ? '中' : 'EN'}</span>
            <span class="language-select-chevron" aria-hidden="true">▾</span>
          </button>
          <div
            id="language-select-options"
            class="language-options"
            role="listbox"
            aria-label={t.language.selector}
            hidden
          >
            <a
              href={sisterPath(currentPath, 'en')}
              class="language-option"
              role="option"
              data-language-value="en"
              aria-selected={locale === 'en' ? 'true' : 'false'}
            >English</a>
            <a
              href={sisterPath(currentPath, 'zh-Hans')}
              class="language-option"
              role="option"
              data-language-value="zh-Hans"
              aria-selected={locale === 'zh-Hans' ? 'true' : 'false'}
            >简体中文</a>
          </div>
        </div>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  // Theme + language picker behavior. Inline so it's available before
  // the page hydrates and survives GitHub Pages's no-JS-by-default.
  (function () {
    // -- Theme toggle ------------------------------------------------
    var themeButtons = document.querySelectorAll('[data-theme-option]');
    function syncThemePressed() {
      var mode = document.documentElement.dataset.themeMode || 'auto';
      themeButtons.forEach(function (b) {
        b.setAttribute('aria-pressed', b.getAttribute('data-theme-option') === mode ? 'true' : 'false');
      });
    }
    themeButtons.forEach(function (b) {
      b.addEventListener('click', function () {
        var opt = b.getAttribute('data-theme-option');
        try { localStorage.setItem('dosecare-theme', opt); } catch (e) {}
        var theme =
          opt === 'auto'
            ? (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : opt;
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.themeMode = opt;
        syncThemePressed();
      });
    });
    syncThemePressed();

    // -- Language picker ---------------------------------------------
    var picker = document.querySelector('[data-language-picker]');
    if (picker) {
      var btn = picker.querySelector('#language-select-button');
      var menu = picker.querySelector('#language-select-options');
      if (btn && menu) {
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          var isOpen = !menu.hasAttribute('hidden');
          if (isOpen) {
            menu.setAttribute('hidden', '');
            btn.setAttribute('aria-expanded', 'false');
          } else {
            menu.removeAttribute('hidden');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
        document.addEventListener('click', function (e) {
          if (!picker.contains(e.target)) {
            menu.setAttribute('hidden', '');
            btn.setAttribute('aria-expanded', 'false');
          }
        });
      }
    }
  })();
</script>
